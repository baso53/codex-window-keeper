#!/usr/bin/env bash
set -euo pipefail

PATH="$HOME/.local/bin:$HOME/bin:/usr/local/bin:/usr/bin:/bin"

CODEX_BIN="${CODEX_BIN:-$(command -v codex || true)}"
STATE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/codex-window-keeper"

mkdir -p "$STATE_DIR"
chmod 700 "$STATE_DIR"

MODE="run"

case "${1:-}" in
    "") ;;
    --status)  MODE="status" ;;
    --dry-run) MODE="dry-run" ;;
    -h|--help)
        cat <<'EOF'
Usage:
  codex-window-keeper
  codex-window-keeper --status
  codex-window-keeper --dry-run
EOF
        exit 0
        ;;
    *)
        echo "Unknown argument: $1" >&2
        exit 2
        ;;
esac

if [[ -z "$CODEX_BIN" || ! -x "$CODEX_BIN" ]]; then
    echo "ERROR: codex executable not found" >&2
    exit 1
fi

exec 9>"$STATE_DIR/lock"
flock -n 9 || {
    [[ "$MODE" != "run" ]] && echo "Another keeper instance is running."
    exit 0
}

raw="$(
    CODEX_BIN="$CODEX_BIN" python3 <<'PY'
import json
import os
import select
import subprocess
import sys
import time

codex = os.environ["CODEX_BIN"]

try:
    p = subprocess.Popen(
        [codex, "app-server"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        bufsize=1,
    )
except Exception as e:
    print("ERROR|" + str(e))
    sys.exit(0)

next_id = 1

def send(method, params=None):
    global next_id

    ident = next_id
    next_id += 1

    p.stdin.write(json.dumps({
        "jsonrpc": "2.0",
        "id": ident,
        "method": method,
        "params": params or {}
    }) + "\n")
    p.stdin.flush()

    return ident

def wait_for_id(ident, timeout=8):
    deadline = time.time() + timeout

    while time.time() < deadline:
        ready, _, _ = select.select(
            [p.stdout], [], [],
            max(0, deadline - time.time())
        )

        if not ready:
            return None

        line = p.stdout.readline()

        if not line:
            return None

        try:
            msg = json.loads(line)
        except Exception:
            continue

        if msg.get("id") == ident:
            return msg

    return None

def get(obj, *names):
    if not isinstance(obj, dict):
        return None

    for name in names:
        if name in obj:
            return obj[name]

    return None

def number(value):
    try:
        return float(value)
    except (TypeError, ValueError):
        return None

def epoch(value):
    n = number(value)

    if n is None:
        return None

    if n > 10_000_000_000:
        n /= 1000.0

    return n

def duration(obj):
    return number(get(
        obj,
        "windowMinutes",
        "window_minutes",
        "windowDurationMinutes",
        "window_duration_minutes",
        "windowDurationMins",
        "window_duration_mins",
    ))

def reset(obj):
    return epoch(get(
        obj,
        "resetsAt",
        "resets_at",
        "resetAt",
        "reset_at",
    ))

def usage(obj):
    return number(get(
        obj,
        "usedPercent",
        "used_percent",
        "usagePercent",
        "usage_percent",
        "percentUsed",
        "percent_used",
    ))

def find_windows(result):
    limits = (
        result.get("rateLimits")
        or result.get("rate_limits")
        or result
    )

    found = []

    def walk(obj):
        if isinstance(obj, dict):
            d = duration(obj)

            if d is not None:
                found.append((obj, d))

            for value in obj.values():
                walk(value)

        elif isinstance(obj, list):
            for value in obj:
                walk(value)

    walk(limits)

    primary = None
    weekly = None

    for obj, d in found:
        if primary is None and 270 <= d <= 330:
            primary = obj

        if weekly is None and 9000 <= d <= 11000:
            weekly = obj

    if isinstance(limits, dict):
        if primary is None and isinstance(limits.get("primary"), dict):
            primary = limits["primary"]

        if weekly is None:
            for name in ("secondary", "weekly"):
                if isinstance(limits.get(name), dict):
                    weekly = limits[name]
                    break

    return primary, weekly

def read_limits():
    ident = send("account/rateLimits/read")
    response = wait_for_id(ident)

    if response is None:
        raise RuntimeError("no rate-limit response from Codex")

    if "error" in response:
        raise RuntimeError(
            "rate-limit request failed: " + str(response["error"])
        )

    result = response.get("result") or {}
    primary, weekly = find_windows(result)

    if primary is None:
        raise RuntimeError(
            "could not identify the 5-hour rate-limit window"
        )

    return {
        "primary_reset": reset(primary),
        "primary_usage": usage(primary),
        "weekly_reset": reset(weekly) if weekly else None,
        "weekly_usage": usage(weekly) if weekly else None,
    }

def out(value):
    if value is None:
        return ""

    if float(value).is_integer():
        return str(int(value))

    return f"{value:.3f}".rstrip("0").rstrip(".")

try:
    ident = send("initialize", {
        "clientInfo": {
            "name": "codex-window-keeper",
            "version": "2.0"
        }
    })

    response = wait_for_id(ident)

    if response is None:
        raise RuntimeError("no initialize response from Codex")

    if "error" in response:
        raise RuntimeError(
            "initialize failed: " + str(response["error"])
        )

    #
    # CRITICAL:
    # An unstarted Codex window reports a fake/sliding reset of now+5h.
    # Probe twice. A real started window has a fixed reset timestamp.
    #
    first = read_limits()

    time.sleep(2)

    second = read_limits()

    r1 = first["primary_reset"]
    r2 = second["primary_reset"]
    u2 = second["primary_usage"]

    now = time.time()

    if r2 is None or r2 <= now:
        state = "NOT_STARTED"

    elif u2 is not None and u2 > 0:
        # Any actual usage proves the window exists.
        state = "STARTED"

    elif r1 is not None and abs(r2 - r1) < 0.5:
        # Usage may round to 0%, but a fixed reset proves it is pinned.
        state = "STARTED"

    else:
        # Reset moved between probes => synthetic now+5h window.
        state = "NOT_STARTED"

    wu = second["weekly_usage"]
    wr = second["weekly_reset"]

    weekly_exhausted = (
        wu is not None
        and wu >= 100
        and (wr is None or wr > now)
    )

    print("|".join([
        state,
        out(r1),
        out(r2),
        out(u2),
        out(wr),
        out(wu),
        "1" if weekly_exhausted else "0",
    ]))

except Exception as e:
    print("ERROR|" + str(e))

finally:
    try:
        p.terminate()
        p.wait(timeout=1)
    except Exception:
        try:
            p.kill()
        except Exception:
            pass
PY
)"

if [[ "$raw" == ERROR\|* ]]; then
    echo "ERROR: ${raw#ERROR|}" >&2
    exit 1
fi

IFS='|' read -r \
    WINDOW_STATE \
    RESET_FIRST \
    RESET_SECOND \
    WINDOW_USAGE \
    WEEKLY_RESET \
    WEEKLY_USAGE \
    WEEKLY_EXHAUSTED \
    <<< "$raw"

format_time() {
    if [[ -n "$1" ]]; then
        date -d "@${1%.*}" '+%Y-%m-%d %H:%M:%S %Z'
    else
        echo "unknown"
    fi
}

format_usage() {
    if [[ -n "$1" ]]; then
        printf '%s%%\n' "$1"
    else
        echo "unknown"
    fi
}

show_status() {
    if [[ "$WINDOW_STATE" == "STARTED" ]]; then
        echo "5-hour window: STARTED"
        echo "5-hour usage: $(format_usage "$WINDOW_USAGE")"
        echo "5-hour reset: $(format_time "$RESET_SECOND")"

        reset="${RESET_SECOND%.*}"
        remaining=$((reset - $(date +%s)))
        (( remaining < 0 )) && remaining=0

        printf 'Remaining: %dh %dm\n' \
            $((remaining / 3600)) \
            $(((remaining % 3600) / 60))

    else
        echo "5-hour window: NOT STARTED"
        echo "5-hour usage: $(format_usage "$WINDOW_USAGE")"

        if [[ -n "$RESET_FIRST" && -n "$RESET_SECOND" ]]; then
            echo "Sliding reset detected:"
            echo "  Probe 1: $(format_time "$RESET_FIRST")"
            echo "  Probe 2: $(format_time "$RESET_SECOND")"
        fi
    fi

    echo
    echo "Weekly usage: $(format_usage "$WEEKLY_USAGE")"

    if [[ -n "$WEEKLY_RESET" ]]; then
        echo "Weekly reset: $(format_time "$WEEKLY_RESET")"
    fi

    echo

    if [[ "$WINDOW_STATE" == "STARTED" ]]; then
        if [[ -n "$WINDOW_USAGE" ]] &&
           awk "BEGIN { exit !($WINDOW_USAGE >= 100) }"; then
            echo "Action: waiting for the current 5-hour window to reset."
        else
            echo "Action: nothing; 5-hour window is genuinely started."
        fi

    elif [[ "$WEEKLY_EXHAUSTED" == "1" ]]; then
        echo "Action: weekly quota exhausted; waiting for weekly reset."

    elif [[ "$MODE" == "dry-run" ]]; then
        echo "Action: would send one minimal Codex query to start the 5-hour window."

    else
        echo "Action: 5-hour window needs to be started."
    fi
}

if [[ "$MODE" == "status" || "$MODE" == "dry-run" ]]; then
    show_status
fi

# Already pinned.
if [[ "$WINDOW_STATE" == "STARTED" ]]; then
    exit 0
fi

# No point making a model request while weekly quota is exhausted.
if [[ "$WEEKLY_EXHAUSTED" == "1" ]]; then
    exit 0
fi

# Safety modes never make a model request.
if [[ "$MODE" == "status" || "$MODE" == "dry-run" ]]; then
    exit 0
fi

#
# Window is genuinely unstarted. Pin it with one minimal model request.
#

workdir="$STATE_DIR/empty-workdir"
mkdir -p "$workdir"
cd "$workdir"

args=(exec --skip-git-repo-check)

if "$CODEX_BIN" exec --help 2>&1 | grep -q -- '--ephemeral'; then
    args+=(--ephemeral)
fi

if "$CODEX_BIN" exec --help 2>&1 | grep -q -- '--sandbox'; then
    args+=(--sandbox read-only)
fi

if "$CODEX_BIN" "${args[@]}" \
    'Reply with exactly: OK. Do not inspect files, run commands, or use tools.' \
    >/dev/null 2>"$STATE_DIR/last-error.log"
then
    date +%s > "$STATE_DIR/last-trigger"
    exit 0
fi

echo "ERROR: failed to start new Codex window" >&2
cat "$STATE_DIR/last-error.log" >&2
exit 1
